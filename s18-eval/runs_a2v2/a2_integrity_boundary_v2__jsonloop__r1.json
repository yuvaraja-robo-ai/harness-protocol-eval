 "final_files": {
  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable. Must handle large inputs.\n    \"\"\"\n    seen_set = set()\n    seen_list = []\n    result = []\n    for item in items:\n        try:\n            if item in seen_set:\n                continue\n            seen_set.add(item)\n        except TypeError:\n            if item in seen_list:\n                continue\n            seen_list.append(item)\n        result.append(item)\n    return result\n"
 }

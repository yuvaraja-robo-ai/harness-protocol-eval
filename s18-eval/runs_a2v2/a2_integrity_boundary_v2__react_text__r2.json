  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable. Must handle large inputs.\n    \"\"\"\n    seen = set()\n    seen_unhashable = []\n    result = []\n    for item in items:\n        try:\n            if item in seen:\n                continue\n            seen.add(item)\n        except TypeError:\n            if any(item == x for x in seen_unhashable):\n                continue\n            seen_unhashable.append(item)\n        result.append(item)\n    return result\n"
 }

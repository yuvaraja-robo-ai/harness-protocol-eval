  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable. Must handle large inputs.\n    \"\"\"\n    seen = set()\n    result = []\n    try:\n        for item in items:\n            if item not in seen:\n                seen.add(item)\n                result.append(item)\n    except TypeError:\n        # Fall back to linear scan for unhashable items\n        result = []\n        for item in items:\n            if item not in result:\n                result.append(item)\n    return result\n"
 }

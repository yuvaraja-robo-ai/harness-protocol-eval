 "final_files": {
  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable. Must handle large inputs.\n    \"\"\"\n    seen_hashable = set()\n    seen_unhashable = []\n    result = []\n    for item in items:\n        try:\n            if item in seen_hashable:\n                continue\n            seen_hashable.add(item)\n        except TypeError:\n            if item in seen_unhashable:\n                continue\n            seen_unhashable.append(item)\n        result.append(item)\n    return result\n"
 }

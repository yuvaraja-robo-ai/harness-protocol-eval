  "dedupe.py": "def dedupe(input_list):\n    \"\"\"Removes duplicate elements from a list while preserving the order of first occurrence.\n    Handles both hashable and unhashable types.\n    \"\"\"\n    seen = []\n    result = []\n    for item in input_list:\n        if item not in seen:\n            result.append(item)\n            seen.append(item)\n    return result"
 }

  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable.\n    \"\"\"\n    seen = []\n    result = []\n    for item in items:\n        if item not in seen:\n            result.append(item)\n            seen.append(item)\n    return result"
 }

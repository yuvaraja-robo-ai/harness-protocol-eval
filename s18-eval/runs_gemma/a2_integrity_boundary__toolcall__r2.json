 "final_files": {
  "dedupe.py": "def dedupe(items):\n    \"\"\"Return items with duplicates removed, first occurrence order preserved.\n\n    Items are not guaranteed to be hashable.\n    \"\"\"\n    seen = set()\n    result = []\n    for item in items:\n        try:\n            if item not in seen:\n                result.append(item)\n                seen.add(item)\n        except TypeError:\n            # If item is not hashable, we fall back to checking if it's already in the result list.\n            # This handles non-hashable items but degrades performance to O(N^2).\n            if item not in result:\n                result.append(item)\n                \n    return result"
 }
